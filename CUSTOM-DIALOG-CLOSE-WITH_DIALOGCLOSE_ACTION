### 2 need to add this js code in popup page execute when page load javascript action
------------------------------------------------------------------------------------------------
Note : at line "apex.event.trigger(document, "customDialogClose");" this will trigger page level created dynamic action which event type = custom,
this action close the dialog and pass the value when dialog will close.
---------------------------------------------------------------------------------------------------------------------------------------------------
(function () {

    var $parent = parent.apex ? parent.apex.jQuery : parent.jQuery;
    var $dialog = $parent(".ui-dialog:visible").last();

    if (!$dialog.length) {
        return;
    }

    $dialog.find(".ui-dialog-titlebar-close").hide();

    if ($dialog.find("#CUSTOM_DIALOG_CLOSE").length) {
        return;
    }

    var $customCloseLink = $parent(
        '<a href="javascript:void(0);" ' +
        'id="CUSTOM_DIALOG_CLOSE" ' +
        'class="t-Button t-Button--icon t-Button--default custom-apex-dialog-close" ' +
        'title="Close" aria-label="Close">' +
            '<span class="t-Icon fa fa-remove" aria-hidden="true"></span>' +
        '</a>'
    );

    $customCloseLink.on("click", function (e) {
        e.preventDefault();
        e.stopPropagation();

        // Trigger custom event inside popup page
        apex.event.trigger(document, "customDialogClose");
    });

    $dialog.find(".ui-dialog-titlebar").append($customCloseLink);

})();

